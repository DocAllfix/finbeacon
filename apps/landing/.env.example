# Variabili della vetrina (apps/landing). Copia in .env.local per lo sviluppo.
# In produzione stanno sul progetto Vercel `finbeacon-landing`, non qui.
#
# Tutte sono FACOLTATIVE, e l'assenza non rompe niente: un pulsante che
# dipende da una variabile mancante non viene disegnato, invece di portare a
# un muro. Le quattro del modulo fanno eccezione — vedi in fondo.

# --- Chi pubblica il sito ---
# Per una ditta individuale la legge vuole che sul sito siano REPERIBILI nome e
# cognome, domicilio o sede, posta elettronica, recapito telefonico e partita
# IVA: artt. 2199 e 2250 c.c., art. 7 D.Lgs. 70/2003, DPR 633/1972. Nome e
# partita IVA compaiono nel piede di ogni pagina; il resto nelle note legali.
#
# Se mancano, le note legali mostrano un segnaposto tratteggiato che ELENCA cosa
# manca, e il build avvisa a voce alta senza fermarsi: togliere il sito non lo
# rende conforme, lo rende assente. Con il modulo di contatto attivo invece
# diventano obbligatorie, perché lì si sollecita un contatto commerciale.
LEGALE_NOME=
LEGALE_INDIRIZZO=
LEGALE_TELEFONO=
LEGALE_PIVA=
# Facoltativo: il numero REA, solo se l'impresa è iscritta al registro.
LEGALE_REA=
# Facoltativo: nessuna di quelle norme lo pretende espressamente, e per una
# persona fisica è un dato in più esposto al pubblico. Si mette solo se si vuole.
LEGALE_CF=

# --- Pagine legali ---
# Indirizzo per le richieste privacy: finisce nell'informativa. Senza, la pagina
# mostra un segnaposto tratteggiato invece di un testo che sembra definitivo.
LEGALE_EMAIL_PRIVACY=
# Per quanto si conservano le richieste. Se vuota vale un CRITERIO, non una
# durata inventata: l'art. 13 GDPR ammette il criterio.
PRIVACY_CONSERVAZIONE=

# --- Collegamenti in uscita (visibili nel browser) ---
# Calendario per «Prenota una chiamata». Link esterno, mai incorporato: un
# calendario incorporato porta cookie di terzi in un sito che non ne ha.
NEXT_PUBLIC_URL_PRENOTAZIONE=
# Istanza dimostrativa pubblica: fa comparire «Entra nella demo».
NEXT_PUBLIC_URL_DEMO=https://demo.finbeacon.eu/demo
# Indirizzo mostrato come ripiego se l'invio del modulo fallisce.
NEXT_PUBLIC_EMAIL_CONTATTO=

# --- Il modulo di contatto ---
# ATTENZIONE: queste quattro più LEGALE_NOME e LEGALE_EMAIL_PRIVACY sono
# OBBLIGATORIE insieme quando DEMO_ATTIVO="true". `scripts/verifica-lancio.mjs`
# ferma il build di produzione se il modulo raccoglie dati e manca quello che
# l'art. 13 GDPR pretende accanto (GUASTI G-48).
#
# Con DEMO_ATTIVO diverso da "true" il sito si pubblica lo stesso: il modulo
# resta visibile, non spedisce, e lo DICHIARA in pagina.
DEMO_ATTIVO=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Il mittente. Una casella VERA e autenticata, non un no-reply@ che nessuno
# presidia: spedire da un indirizzo inesistente peggiora la consegna e vieta
# la risposta. L'indirizzo di chi scrive finisce in Reply-To.
SMTP_FROM=
# Dove arrivano le richieste.
DEMO_DESTINATARIO=
